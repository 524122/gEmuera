{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-declaration-vocabulary-catalog-1.0.0.json",
  "title": "gEmuera M0 static declaration vocabulary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogVersion", "sourceWorkPackage", "sourceInventoryWorkPackage", "sourceCompatibilityPackWorkPackage", "sourceInventoryHash", "sourceCompatibilityPackHash", "expectedSourceClassificationCount", "expectedBranchHitCount", "declarations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "sourceWorkPackage": {"const": "M0-DIA-13"}, "sourceInventoryWorkPackage": {"const": "M0-DIA-01"}, "sourceCompatibilityPackWorkPackage": {"const": "M0-DIA-12"}, "sourceInventoryHash": {"$ref": "#/$defs/sha256"}, "sourceCompatibilityPackHash": {"$ref": "#/$defs/sha256"}, "expectedSourceClassificationCount": {"const": 30}, "expectedBranchHitCount": {"const": 97}, "declarations": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/declaration"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "declaration": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "expectedBranchHitCount", "sourceClassificationIds", "targetModuleIds", "fixtureIds", "declarationStatus", "currentPackEligibility"], "properties": {"kind": {"enum": ["BehaviorKey", "CapabilityId"]}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "expectedBranchHitCount": {"type": "integer", "minimum": 1}, "sourceClassificationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "targetModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fixtureIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "declarationStatus": {"const": "StaticCandidate"}, "currentPackEligibility": {"const": "NotEligible"}}}
  }
}
