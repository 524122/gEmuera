{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-policy-surface-1.0.0.json",
  "title": "gEmuera M0 static future policy surface contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourcePolicyConsumerBoundaryHash", "sourceDeclarationVocabularyHash", "catalogId", "catalogVersion", "catalogHash", "policySurfaceSetHash", "surfaceCounts", "currentDeclarationVocabularyExposure", "contracts", "currentRuntimeIsolation", "parserVmConsumption", "compatibilityPlanRuntime", "policyManagerRuntime", "runtimeTypeDeclarations", "m1Eligibility", "uncovered"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "workPackage": {"const": "M0-DIA-15"}, "generatedAtUtc": {"type": "string", "format": "date-time"}, "executionStatus": {"const": "InProgress"}, "gateStatus": {"const": "Blocked"}, "blockerCode": {"const": "EvidenceMissing"}, "result": {"const": "Partial"},
    "sourcePolicyConsumerBoundaryHash": {"$ref": "#/$defs/sha256"}, "sourceDeclarationVocabularyHash": {"$ref": "#/$defs/sha256"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "catalogHash": {"$ref": "#/$defs/sha256"}, "policySurfaceSetHash": {"$ref": "#/$defs/sha256"},
    "surfaceCounts": {"$ref": "#/$defs/counts"}, "currentDeclarationVocabularyExposure": {"$ref": "#/$defs/exposure"}, "contracts": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/contract"}},
    "currentRuntimeIsolation": {"$ref": "#/$defs/failed"}, "parserVmConsumption": {"$ref": "#/$defs/notConsumed"}, "compatibilityPlanRuntime": {"$ref": "#/$defs/notImplemented"}, "policyManagerRuntime": {"$ref": "#/$defs/notImplemented"}, "runtimeTypeDeclarations": {"$ref": "#/$defs/notImplemented"}, "m1Eligibility": {"$ref": "#/$defs/blocked"}, "uncovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["behaviorKeyCount", "contractCount", "policyDecisionCount", "bridgeProjectionCount", "frozenCatalogContributionCount", "sourceBindingCount"], "properties": {"behaviorKeyCount": {"const": 10}, "contractCount": {"const": 10}, "policyDecisionCount": {"const": 6}, "bridgeProjectionCount": {"const": 2}, "frozenCatalogContributionCount": {"const": 2}, "sourceBindingCount": {"const": 14}}},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["status", "allowedCapabilityIds", "reason"], "properties": {"status": {"const": "NoRuntimeCapabilitiesDeclared"}, "allowedCapabilityIds": {"type": "array", "maxItems": 0}, "reason": {"type": "string", "minLength": 1}}},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["classificationId", "role", "branchHitCount", "sourceFilePaths", "currentOwners", "intendedOwners", "targetModuleIds", "fixtureIds"], "properties": {"classificationId": {"type": "string", "minLength": 1}, "role": {"enum": ["DecisionConsumer", "ConfigurationInput"]}, "branchHitCount": {"type": "integer", "minimum": 1}, "sourceFilePaths": {"$ref": "#/$defs/stringSet"}, "currentOwners": {"$ref": "#/$defs/stringSet"}, "intendedOwners": {"$ref": "#/$defs/stringSet"}, "targetModuleIds": {"$ref": "#/$defs/stringSet"}, "fixtureIds": {"$ref": "#/$defs/stringSet"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["behaviorKeyId", "consumerContractId", "decisionOwner", "portTypeId", "contractKind", "branchHitCount", "currentOwners", "sourceIntendedOwners", "sourceClassificationIds", "sourceFilePaths", "targetModuleIds", "fixtureIds", "sourceBindings", "contractDraftStatus", "policyValueStatus", "runtimeStatus"], "properties": {"behaviorKeyId": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "consumerContractId": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "decisionOwner": {"type": "string", "minLength": 1}, "portTypeId": {"type": "string", "pattern": "^I[A-Za-z][A-Za-z0-9]*$"}, "contractKind": {"enum": ["PolicyDecision", "BridgeProjection", "FrozenCatalogContribution"]}, "branchHitCount": {"type": "integer", "minimum": 1}, "currentOwners": {"$ref": "#/$defs/stringSet"}, "sourceIntendedOwners": {"$ref": "#/$defs/stringSet"}, "sourceClassificationIds": {"$ref": "#/$defs/stringSet"}, "sourceFilePaths": {"$ref": "#/$defs/stringSet"}, "targetModuleIds": {"$ref": "#/$defs/stringSet"}, "fixtureIds": {"$ref": "#/$defs/stringSet"}, "sourceBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceBinding"}}, "contractDraftStatus": {"const": "InterfaceDraftOnly"}, "policyValueStatus": {"const": "Unspecified"}, "runtimeStatus": {"const": "NotImplemented"}}},
    "failed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Failed"}, "reason": {"type": "string", "minLength": 1}}}, "notConsumed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotConsumed"}, "reason": {"type": "string", "minLength": 1}}}, "notImplemented": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotImplemented"}, "reason": {"type": "string", "minLength": 1}}}, "blocked": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Blocked"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
