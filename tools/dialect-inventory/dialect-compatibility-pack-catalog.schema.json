{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-compatibility-pack-catalog-1.0.0.json",
  "title": "gEmuera M0 CompatibilityPack static declaration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogVersion", "sourceWorkPackage", "sourcePlanPreflightWorkPackage", "sourceProfileSelectionWorkPackage", "sourcePlanPreflightHash", "sourceProfileSelectionHash", "compatibilityPackSchema", "externalCodePolicy", "allowedCapabilityIds", "builtInModules", "profileContracts", "packs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "sourceWorkPackage": {"const": "M0-DIA-12"}, "sourcePlanPreflightWorkPackage": {"const": "M0-DIA-10"}, "sourceProfileSelectionWorkPackage": {"const": "M0-DIA-11"}, "sourcePlanPreflightHash": {"$ref": "#/$defs/sha256"}, "sourceProfileSelectionHash": {"$ref": "#/$defs/sha256"}, "compatibilityPackSchema": {"const": "emuera.compatibility-pack/v1"}, "externalCodePolicy": {"const": "BuiltInCompiledOnly"},
    "allowedCapabilityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "builtInModules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}, "profileContracts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/profileContract"}}, "packs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/pack"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "module": {"type": "object", "additionalProperties": false, "required": ["id", "declarationVersion", "profileIds", "payloadKind", "distributionStatus"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]+$"}, "declarationVersion": {"$ref": "#/$defs/semver"}, "profileIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["v24pure", "snake"]}}, "payloadKind": {"const": "BuiltInCompiledOnly"}, "distributionStatus": {"const": "StaticEvidenceOnly"}}},
    "profileContract": {"type": "object", "additionalProperties": false, "required": ["profileId", "packId", "legacyCoreProfileEnum", "builtInModuleIds", "projectionEvidenceModuleIds"], "properties": {"profileId": {"enum": ["v24pure", "snake"]}, "packId": {"type": "string", "minLength": 1}, "legacyCoreProfileEnum": {"enum": ["V24Pure", "Snake"]}, "builtInModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "projectionEvidenceModuleIds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "pack": {"type": "object", "additionalProperties": false, "required": ["packId", "declarationVersion", "profileId", "builtInModuleIds", "projectionEvidenceModuleIds", "requiredCapabilities", "optionalCapabilities", "saveProfileEvidenceStatus", "fixtureEvidenceStatus", "contentBindingStatus", "distributionEligibility"], "properties": {"packId": {"type": "string", "minLength": 1}, "declarationVersion": {"$ref": "#/$defs/semver"}, "profileId": {"enum": ["v24pure", "snake"]}, "builtInModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "projectionEvidenceModuleIds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "optionalCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "saveProfileEvidenceStatus": {"const": "Uncovered"}, "fixtureEvidenceStatus": {"const": "Uncovered"}, "contentBindingStatus": {"const": "NotBound"}, "distributionEligibility": {"const": "Blocked"}}}
  }
}
