{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-module-composition-1.0.0.json",
  "title": "gEmuera M0 static dialect module composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourceCompatibilityPackHash", "sourcePolicySurfaceHash", "catalogId", "catalogVersion", "catalogHash", "moduleCompositionSetHash", "compositionCounts", "currentCompatibilityPackExposure", "modules", "profileClosures", "currentRuntimeIsolation", "parserVmConsumption", "compatibilityPlanRuntime", "resolverRuntime", "runtimeModuleCatalog", "m1Eligibility", "uncovered"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "workPackage": {"const": "M0-DIA-16"}, "generatedAtUtc": {"type": "string", "format": "date-time"}, "executionStatus": {"const": "InProgress"}, "gateStatus": {"const": "Blocked"}, "blockerCode": {"const": "EvidenceMissing"}, "result": {"const": "Partial"},
    "sourceCompatibilityPackHash": {"$ref": "#/$defs/sha256"}, "sourcePolicySurfaceHash": {"$ref": "#/$defs/sha256"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "catalogHash": {"$ref": "#/$defs/sha256"}, "moduleCompositionSetHash": {"$ref": "#/$defs/sha256"},
    "compositionCounts": {"$ref": "#/$defs/counts"}, "currentCompatibilityPackExposure": {"$ref": "#/$defs/exposure"}, "modules": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/module"}}, "profileClosures": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/profileClosure"}},
    "currentRuntimeIsolation": {"$ref": "#/$defs/failed"}, "parserVmConsumption": {"$ref": "#/$defs/notConsumed"}, "compatibilityPlanRuntime": {"$ref": "#/$defs/notImplemented"}, "resolverRuntime": {"$ref": "#/$defs/notImplemented"}, "runtimeModuleCatalog": {"$ref": "#/$defs/notImplemented"}, "m1Eligibility": {"$ref": "#/$defs/blocked"}, "uncovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["moduleDescriptorCount", "dependencyEdgeCount", "portDeclarationCount", "profileClosureCount"], "properties": {"moduleDescriptorCount": {"const": 2}, "dependencyEdgeCount": {"const": 1}, "portDeclarationCount": {"const": 10}, "profileClosureCount": {"const": 2}}},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["status", "allowedCapabilityIds", "reason"], "properties": {"status": {"const": "NoRuntimeCapabilitiesDeclared"}, "allowedCapabilityIds": {"type": "array", "maxItems": 0}, "reason": {"type": "string", "minLength": 1}}},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["classificationId", "role", "branchHitCount", "sourceFilePaths", "currentOwners", "intendedOwners", "targetModuleIds", "fixtureIds"], "properties": {"classificationId": {"type": "string", "minLength": 1}, "role": {"enum": ["DecisionConsumer", "ConfigurationInput"]}, "branchHitCount": {"type": "integer", "minimum": 1}, "sourceFilePaths": {"$ref": "#/$defs/stringSet"}, "currentOwners": {"$ref": "#/$defs/stringSet"}, "intendedOwners": {"$ref": "#/$defs/stringSet"}, "targetModuleIds": {"$ref": "#/$defs/stringSet"}, "fixtureIds": {"$ref": "#/$defs/stringSet"}}},
    "module": {"type": "object", "additionalProperties": false, "required": ["moduleId", "moduleVersion", "moduleApiVersion", "dependencyModuleIds", "declaredPortTypeIds", "sourceBehaviorKeyIds", "descriptorStatus", "runtimeStatus", "distributionEligibility"], "properties": {"moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*$"}, "moduleVersion": {"$ref": "#/$defs/semver"}, "moduleApiVersion": {"type": "integer", "minimum": 1}, "dependencyModuleIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "declaredPortTypeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^I[A-Za-z][A-Za-z0-9]*$"}}, "sourceBehaviorKeyIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}}, "descriptorStatus": {"const": "StaticCandidate"}, "runtimeStatus": {"const": "NotImplemented"}, "distributionEligibility": {"const": "Blocked"}}},
    "profileClosure": {"type": "object", "additionalProperties": false, "required": ["profileId", "packId", "legacyCoreProfileEnum", "selectedModuleIds", "resolvedModuleIds", "profileStatus", "runtimeStatus"], "properties": {"profileId": {"enum": ["v24pure", "snake"]}, "packId": {"type": "string", "minLength": 1}, "legacyCoreProfileEnum": {"type": "string", "minLength": 1}, "selectedModuleIds": {"$ref": "#/$defs/stringSet"}, "resolvedModuleIds": {"$ref": "#/$defs/stringSet"}, "profileStatus": {"const": "StaticCandidate"}, "runtimeStatus": {"const": "NotImplemented"}}},
    "failed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Failed"}, "reason": {"type": "string", "minLength": 1}}}, "notConsumed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotConsumed"}, "reason": {"type": "string", "minLength": 1}}}, "notImplemented": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotImplemented"}, "reason": {"type": "string", "minLength": 1}}}, "blocked": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Blocked"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
