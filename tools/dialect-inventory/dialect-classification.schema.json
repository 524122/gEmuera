{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-classification-1.0.0.json",
  "title": "gEmuera M0 dialect branch classification catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "classifications"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workPackage": { "const": "M0-DIA-01" },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "markerId", "fileRegex", "category", "currentOwner", "intendedOwner", "targetModule", "behaviorKey", "capabilityId", "fixtureId", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "markerId": { "type": "string", "minLength": 1 },
          "fileRegex": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "currentOwner": { "type": "string", "minLength": 1 },
          "intendedOwner": { "type": "string", "minLength": 1 },
          "targetModule": { "type": "string", "minLength": 1 },
          "behaviorKey": { "type": "string" },
          "capabilityId": { "type": "string" },
          "fixtureId": { "type": "string", "pattern": "^DIA-" },
          "notes": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "properties": { "behaviorKey": { "minLength": 1 } } },
          { "properties": { "capabilityId": { "minLength": 1 } } }
        ]
      }
    }
  }
}
