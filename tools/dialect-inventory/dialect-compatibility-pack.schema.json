{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-compatibility-pack-1.0.0.json",
  "title": "gEmuera M0 CompatibilityPack declaration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourcePlanPreflightHash", "sourceProfileSelectionHash", "catalogId", "catalogVersion", "catalogHash", "compatibilityPackSetHash", "declarationPolicy", "packs", "currentRuntimeIsolation", "parserVmConsumption", "compatibilityPlanRuntime", "resolverRuntime", "m1Eligibility", "uncovered"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "workPackage": {"const": "M0-DIA-12"}, "generatedAtUtc": {"type": "string", "format": "date-time"},
    "executionStatus": {"const": "InProgress"}, "gateStatus": {"const": "Blocked"}, "blockerCode": {"const": "EvidenceMissing"}, "result": {"const": "Partial"},
    "sourcePlanPreflightHash": {"$ref": "#/$defs/sha256"}, "sourceProfileSelectionHash": {"$ref": "#/$defs/sha256"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "catalogHash": {"$ref": "#/$defs/sha256"}, "compatibilityPackSetHash": {"$ref": "#/$defs/sha256"},
    "declarationPolicy": {"$ref": "#/$defs/policy"}, "packs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/pack"}},
    "currentRuntimeIsolation": {"$ref": "#/$defs/failed"}, "parserVmConsumption": {"$ref": "#/$defs/notConsumed"}, "compatibilityPlanRuntime": {"$ref": "#/$defs/notImplemented"}, "resolverRuntime": {"$ref": "#/$defs/notImplemented"}, "m1Eligibility": {"$ref": "#/$defs/blocked"}, "uncovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["compatibilityPackSchema", "externalCodePolicy", "allowedCapabilityIds", "contentBindingStatus", "runtimeModuleLoading", "runtimeResolverStatus"], "properties": {"compatibilityPackSchema": {"const": "emuera.compatibility-pack/v1"}, "externalCodePolicy": {"const": "BuiltInCompiledOnly"}, "allowedCapabilityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "contentBindingStatus": {"const": "NotBound"}, "runtimeModuleLoading": {"const": "NotImplemented"}, "runtimeResolverStatus": {"const": "NotImplemented"}}},
    "pack": {"type": "object", "additionalProperties": false, "required": ["packId", "declarationVersion", "profileId", "legacyCoreProfileEnum", "builtInModuleIds", "staticProjectionSupportModuleIds", "requiredCapabilityIds", "optionalCapabilityIds", "contentBindingStatus", "saveProfileEvidenceStatus", "fixtureEvidenceStatus", "distributionEligibility"], "properties": {"packId": {"type": "string", "minLength": 1}, "declarationVersion": {"$ref": "#/$defs/semver"}, "profileId": {"enum": ["v24pure", "snake"]}, "legacyCoreProfileEnum": {"enum": ["V24Pure", "Snake"]}, "builtInModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "staticProjectionSupportModuleIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^legacy\\.current\\."}}, "requiredCapabilityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "optionalCapabilityIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "contentBindingStatus": {"const": "NotBound"}, "saveProfileEvidenceStatus": {"const": "Uncovered"}, "fixtureEvidenceStatus": {"const": "Uncovered"}, "distributionEligibility": {"const": "Blocked"}}},
    "failed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Failed"}, "reason": {"type": "string", "minLength": 1}}}, "notConsumed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotConsumed"}, "reason": {"type": "string", "minLength": 1}}}, "notImplemented": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotImplemented"}, "reason": {"type": "string", "minLength": 1}}}, "blocked": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Blocked"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
