{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-policy-consumer-boundary-1.0.0.json",
  "title": "gEmuera M0 static BehaviorKey policy consumer boundary audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourceInventoryHash", "sourceDeclarationVocabularyHash", "catalogId", "catalogVersion", "catalogHash", "boundarySetHash", "boundaryCounts", "currentDeclarationVocabularyExposure", "boundaries", "currentRuntimeIsolation", "parserVmConsumption", "compatibilityPlanRuntime", "policyManagerRuntime", "m1Eligibility", "uncovered"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "workPackage": {"const": "M0-DIA-14"}, "generatedAtUtc": {"type": "string", "format": "date-time"}, "executionStatus": {"const": "InProgress"}, "gateStatus": {"const": "Blocked"}, "blockerCode": {"const": "EvidenceMissing"}, "result": {"const": "Partial"},
    "sourceInventoryHash": {"$ref": "#/$defs/sha256"}, "sourceDeclarationVocabularyHash": {"$ref": "#/$defs/sha256"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "catalogHash": {"$ref": "#/$defs/sha256"}, "boundarySetHash": {"$ref": "#/$defs/sha256"},
    "boundaryCounts": {"$ref": "#/$defs/counts"}, "currentDeclarationVocabularyExposure": {"$ref": "#/$defs/exposure"}, "boundaries": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/boundary"}},
    "currentRuntimeIsolation": {"$ref": "#/$defs/failed"}, "parserVmConsumption": {"$ref": "#/$defs/notConsumed"}, "compatibilityPlanRuntime": {"$ref": "#/$defs/notImplemented"}, "policyManagerRuntime": {"$ref": "#/$defs/notImplemented"}, "m1Eligibility": {"$ref": "#/$defs/blocked"}, "uncovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "stringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["behaviorKeyCount", "decisionBoundaryCount", "sourceClassificationBindingCount", "sourceFileBindingCount"], "properties": {"behaviorKeyCount": {"const": 10}, "decisionBoundaryCount": {"const": 10}, "sourceClassificationBindingCount": {"const": 14}, "sourceFileBindingCount": {"const": 16}}},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["status", "allowedCapabilityIds", "reason"], "properties": {"status": {"const": "NoRuntimeCapabilitiesDeclared"}, "allowedCapabilityIds": {"type": "array", "maxItems": 0}, "reason": {"type": "string", "minLength": 1}}},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["classificationId", "role", "branchHitCount", "sourceFilePaths", "currentOwners", "intendedOwners", "targetModuleIds", "fixtureIds"], "properties": {"classificationId": {"type": "string", "minLength": 1}, "role": {"enum": ["DecisionConsumer", "ConfigurationInput"]}, "branchHitCount": {"type": "integer", "minimum": 1}, "sourceFilePaths": {"$ref": "#/$defs/stringSet"}, "currentOwners": {"$ref": "#/$defs/stringSet"}, "intendedOwners": {"$ref": "#/$defs/stringSet"}, "targetModuleIds": {"$ref": "#/$defs/stringSet"}, "fixtureIds": {"$ref": "#/$defs/stringSet"}}},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["behaviorKeyId", "consumerContractId", "decisionOwner", "branchHitCount", "currentOwners", "sourceIntendedOwners", "sourceClassificationIds", "sourceFilePaths", "targetModuleIds", "fixtureIds", "sourceBindings", "boundaryDraftStatus", "runtimeStatus"], "properties": {"behaviorKeyId": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "consumerContractId": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "decisionOwner": {"type": "string", "minLength": 1}, "branchHitCount": {"type": "integer", "minimum": 1}, "currentOwners": {"$ref": "#/$defs/stringSet"}, "sourceIntendedOwners": {"$ref": "#/$defs/stringSet"}, "sourceClassificationIds": {"$ref": "#/$defs/stringSet"}, "sourceFilePaths": {"$ref": "#/$defs/stringSet"}, "targetModuleIds": {"$ref": "#/$defs/stringSet"}, "fixtureIds": {"$ref": "#/$defs/stringSet"}, "sourceBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceBinding"}}, "boundaryDraftStatus": {"const": "BoundaryDraftOnly"}, "runtimeStatus": {"const": "NotImplemented"}}},
    "failed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Failed"}, "reason": {"type": "string", "minLength": 1}}}, "notConsumed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotConsumed"}, "reason": {"type": "string", "minLength": 1}}}, "notImplemented": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotImplemented"}, "reason": {"type": "string", "minLength": 1}}}, "blocked": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Blocked"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
