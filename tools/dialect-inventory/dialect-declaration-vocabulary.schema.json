{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-declaration-vocabulary-1.0.0.json",
  "title": "gEmuera M0 static BehaviorKey and CapabilityId declaration vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workPackage", "generatedAtUtc", "executionStatus", "gateStatus", "blockerCode", "result", "sourceInventoryHash", "sourceCompatibilityPackHash", "catalogId", "catalogVersion", "catalogHash", "vocabularySetHash", "declarationCounts", "currentCompatibilityPackExposure", "declarations", "currentRuntimeIsolation", "parserVmConsumption", "compatibilityPlanRuntime", "resolverRuntime", "m1Eligibility", "uncovered"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"}, "workPackage": {"const": "M0-DIA-13"}, "generatedAtUtc": {"type": "string", "format": "date-time"}, "executionStatus": {"const": "InProgress"}, "gateStatus": {"const": "Blocked"}, "blockerCode": {"const": "EvidenceMissing"}, "result": {"const": "Partial"},
    "sourceInventoryHash": {"$ref": "#/$defs/sha256"}, "sourceCompatibilityPackHash": {"$ref": "#/$defs/sha256"}, "catalogId": {"type": "string", "minLength": 1}, "catalogVersion": {"$ref": "#/$defs/semver"}, "catalogHash": {"$ref": "#/$defs/sha256"}, "vocabularySetHash": {"$ref": "#/$defs/sha256"},
    "declarationCounts": {"$ref": "#/$defs/counts"}, "currentCompatibilityPackExposure": {"$ref": "#/$defs/exposure"}, "declarations": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/declaration"}}, "currentRuntimeIsolation": {"$ref": "#/$defs/failed"}, "parserVmConsumption": {"$ref": "#/$defs/notConsumed"}, "compatibilityPlanRuntime": {"$ref": "#/$defs/notImplemented"}, "resolverRuntime": {"$ref": "#/$defs/notImplemented"}, "m1Eligibility": {"$ref": "#/$defs/blocked"}, "uncovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "counts": {"type": "object", "additionalProperties": false, "required": ["behaviorKeyCount", "capabilityIdCount", "sourceClassificationCount", "branchHitCount"], "properties": {"behaviorKeyCount": {"const": 10}, "capabilityIdCount": {"const": 4}, "sourceClassificationCount": {"const": 30}, "branchHitCount": {"const": 97}}},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["status", "packCount", "allowedCapabilityIds", "reason"], "properties": {"status": {"const": "NoRuntimeCapabilitiesDeclared"}, "packCount": {"const": 2}, "allowedCapabilityIds": {"type": "array", "maxItems": 0}, "reason": {"type": "string", "minLength": 1}}},
    "declaration": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "branchHitCount", "sourceClassificationIds", "targetModuleIds", "fixtureIds", "declarationStatus", "currentPackEligibility", "runtimeStatus"], "properties": {"kind": {"enum": ["BehaviorKey", "CapabilityId"]}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9.\\-]*\\.v[0-9]+$"}, "branchHitCount": {"type": "integer", "minimum": 1}, "sourceClassificationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "targetModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fixtureIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "declarationStatus": {"const": "StaticCandidate"}, "currentPackEligibility": {"const": "NotEligible"}, "runtimeStatus": {"const": "NotImplemented"}}},
    "failed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Failed"}, "reason": {"type": "string", "minLength": 1}}}, "notConsumed": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotConsumed"}, "reason": {"type": "string", "minLength": 1}}}, "notImplemented": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NotImplemented"}, "reason": {"type": "string", "minLength": 1}}}, "blocked": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "Blocked"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
