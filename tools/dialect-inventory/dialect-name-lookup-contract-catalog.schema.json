{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemuera.local/schema/m0-dialect-name-lookup-contract-catalog-1.0.0.json",
  "title": "gEmuera M0 dialect name lookup contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "catalogId", "catalogVersion", "sourceWorkPackage",
    "sourceInventoryWorkPackage", "sourceOwnershipWorkPackage", "sourceFiles",
    "expectedInstructionRegistrationCount", "expectedExpressionRegistrationCount",
    "expectedInstructionLookupSurfaceCount", "expectedCollisionKeys", "contracts"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogId": {"type": "string", "minLength": 1},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceWorkPackage": {"const": "M0-DIA-08"},
    "sourceInventoryWorkPackage": {"const": "M0-DIA-01"},
    "sourceOwnershipWorkPackage": {"const": "M0-DIA-07"},
    "sourceFiles": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"$ref": "#/$defs/sourceFile"}
    },
    "expectedInstructionRegistrationCount": {"const": 326},
    "expectedExpressionRegistrationCount": {"const": 360},
    "expectedInstructionLookupSurfaceCount": {"const": 677},
    "expectedCollisionKeys": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instructionComparerSelector", "instructionComparerWhenTrue", "instructionComparerWhenFalse",
        "instructionNormalizer", "expressionComparer", "expressionNormalizerSelector",
        "expressionNormalizerWhenTrue", "expressionNormalizerWhenFalse", "projectionCollisionPolicy",
        "renameClassification"
      ],
      "properties": {
        "instructionComparerSelector": {"const": "Config.ICVariable"},
        "instructionComparerWhenTrue": {"const": "OrdinalIgnoreCase"},
        "instructionComparerWhenFalse": {"const": "Ordinal"},
        "instructionNormalizer": {"const": "Identity"},
        "expressionComparer": {"const": "Ordinal"},
        "expressionNormalizerSelector": {"const": "Config.ICFunction"},
        "expressionNormalizerWhenTrue": {"const": "CurrentCultureToUpper"},
        "expressionNormalizerWhenFalse": {"const": "Identity"},
        "projectionCollisionPolicy": {"const": "ExistingInstructionWins"},
        "renameClassification": {"const": "SourceTextRewrite"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
