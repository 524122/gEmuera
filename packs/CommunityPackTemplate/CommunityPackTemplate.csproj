<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 社区数据包模板：程序集只内嵌 manifest，不含 ICompatPack 入口类（manifest-only 数据包路径）。 -->
    <EmbeddedResource Include="compatpack.manifest.json" LogicalName="compatpack.manifest.json" />
  </ItemGroup>
</Project>
