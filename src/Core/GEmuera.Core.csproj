<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Godot desktop uses net8.0; Android and local validation use the repository-supported net9.0 SDK. -->
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <!-- Android 导出图整体走 net9.0（Emuera.csproj 同规则）。Core 若不跟随，其 net8.0 目标
         会去引用 Android 下 net9.0-only 的 Emuera 契约程序集 → NU1201，导出 .NET 构建失败。 -->
    <TargetFrameworks Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFrameworks>
    <RootNamespace>GEmuera.Core</RootNamespace>
    <AssemblyName>GEmuera.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 兼容包契约程序集（docs/designs/compat-pack-interface.md §4）：加载器消费
         ICompatPack/CompatPackManifest，且 ALC 契约重定向需要该程序集本体。 -->
    <ProjectReference Include="..\EmueraFacade\Emuera.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 组装器/句柄的 internal 构造点需要直测（手工句柄构造哈希与冲突分支），
         不为此新建夹具程序集。SurfaceSmoke 同理（宿主接线投影用例需要手工句柄）。 -->
    <InternalsVisibleTo Include="GEmuera.Core.Tests" />
    <InternalsVisibleTo Include="LegacyDialectSurfaceSmoke" />
  </ItemGroup>
</Project>
